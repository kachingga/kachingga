{
  "name": "kachingga",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun --filter '@kachingga/api' --filter '@kachingga/web' dev",
    "dev:celu": "KACHINGGA_LAN=1 bun run dev",
    "typecheck": "bun --filter '@kachingga/api' --filter '@kachingga/web' typecheck",
    "test": "bun --filter '@kachingga/api' --filter '@kachingga/web' test",
    "lint": "bun --filter '@kachingga/api' --filter '@kachingga/web' lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "docs:check": "bun scripts/check-docs.ts",
    "check": "bun run docs:check && bun run format:check && bun run typecheck && bun run test && bun run lint",
    "api": "bun run --cwd apps/api dev",
    "web": "bun run --cwd apps/web dev",
    "promote": "bun scripts/promote.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "3.6.2"
  }
}
