{
  "name": "kachingga",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun --filter '*' dev",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint": "bun --filter '*' lint",
    "check": "bun run typecheck && bun run test && bun run lint",
    "api": "bun run --cwd apps/api dev",
    "mobile": "bun run --cwd apps/mobile start"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
