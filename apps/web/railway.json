{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --cwd apps/web build",
    "watchPatterns": ["apps/web/**", "apps/api/src/**", "bun.lock", "package.json"]
  },
  "deploy": {
    "startCommand": "bun apps/web/server.ts",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "multiRegionConfig": {
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    }
  }
}
