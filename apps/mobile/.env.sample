# Copiar a .env. Nunca commitear.
# OJO: todo lo que empieza con EXPO_PUBLIC_ queda embebido en la app y es PÚBLICO. Nunca poner secretos acá.

# Opcional en desarrollo: si se deja vacío, la app usa la IP de la máquina que corre Expo en el puerto 3000.
# Para apuntar a la API de Railway: https://<dominio>.up.railway.app
EXPO_PUBLIC_API_URL=

# Supabase — solo para auth (login / sesión). La data va siempre por la API.
EXPO_PUBLIC_SUPABASE_URL=https://czrkjokurbmbbvobvmxd.supabase.co

# Project Settings → API Keys → Publishable key (pública, segura para la app)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
