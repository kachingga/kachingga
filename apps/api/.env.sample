# Dos archivos, nunca commitear:
#   .env      → DEV  (proyecto stg, ref nraoqdaplvvsakvtlcam). Es lo que usa todo lo local: bun run dev, tests, db:migrate:new/deploy.
#   .env.prod → PROD (proyecto prod, ref czrkjokurbmbbvobvmxd). Solo para `bun run db:migrate:prod` y de referencia para Railway.
# Este sample tiene los valores de DEV; para .env.prod cambiar el ref y las claves por las de prod.
# <DB_PASSWORD>: pedírsela a Galo — Supabase NO la muestra en el dashboard. NUNCA resetearla (rompe a todos).
# Las claves (publishable/secret) sí están en el dashboard: Project Settings → API Keys.

# Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.nraoqdaplvvsakvtlcam:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Project Settings → Database → Connection string → "Session pooler" (puerto 5432) — solo migraciones.
# No usar "Direct connection" (db.<ref>.supabase.co): es solo IPv6 y no anda en la mayoría de las redes ni en Railway.
DIRECT_URL=postgresql://postgres.nraoqdaplvvsakvtlcam:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://nraoqdaplvvsakvtlcam.supabase.co

# Project Settings → API Keys → Secret key. Solo en el server, nunca en la app.
SUPABASE_SECRET_KEY=sb_secret_...

PORT=3000

# Orígenes del front web que pueden llamar a la API (CORS), separados por coma. Local: Vite (5173) y su preview (4173).
# En Railway: la URL de la web de ese entorno (https://app.kachingga.com en prod, https://staging.kachingga.com en staging).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Solo DEV (bun run db:seed): contraseña de los usuarios de prueba (juan.demo@example.com, etc.). Pedírsela a Galo.
# No va en Railway ni en .env.prod.
SEED_USER_PASSWORD=

# Sentry (errores inesperados). Vacío = apagado: así queda en local, tests y CI. En Railway: el DSN del proyecto
# kachingga-api y el entorno (production / staging). Ver docs/claude/repo/monitoreo.md.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Tamaño de la base (MB) a partir del cual la API deja de crear cosas y lo avisa a Sentry. Vacío = sin guardia:
# así queda en local, tests y CI. En Railway: 400 en prod y 80 en staging (INFRA.md).
# MAX_DB_MB=

# Solo .env.prod: passphrase con la que se cifran los backups diarios de prod (secret BACKUP_PASSPHRASE del repo).
# Se genera una vez (DEPLOY.md → "Backups"). No va en .env (dev) ni en Railway.
BACKUP_PASSPHRASE=
