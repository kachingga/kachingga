# Copiar a .env (desarrollo) y a .env.prod (solo para `bun run db:migrate:prod`). Nunca commitear.
# Valores: Supabase dashboard → proyecto czrkjokurbmbbvobvmxd. Pedir las claves por el gestor de contraseñas.

# Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.czrkjokurbmbbvobvmxd:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Project Settings → Database → Connection string → "Session pooler" (puerto 5432) — solo migraciones.
# No usar "Direct connection" (db.<ref>.supabase.co): es solo IPv6 y no anda en la mayoría de las redes ni en Railway.
DIRECT_URL=postgresql://postgres.czrkjokurbmbbvobvmxd:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://czrkjokurbmbbvobvmxd.supabase.co

# Project Settings → API Keys → Secret key. Solo en el server, nunca en la app.
SUPABASE_SECRET_KEY=sb_secret_...

PORT=3000
