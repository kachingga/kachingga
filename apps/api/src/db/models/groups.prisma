model Group {
  id           String    @id @default(cuid())
  name         String
  emoji        String? // shown instead of the initial (one emoji, see groupEmoji in src/schemas.ts)
  photoKey     String? // its photo (lib/photos.ts), shown before the emoji or the initial
  baseCurrency Currency
  inviteCode   String    @unique
  createdById  String // Supabase auth user id
  createdAt    DateTime  @default(now())
  archivedAt   DateTime? // null = active

  participants  Participant[]
  expenses      Expense[]
  settlements   Settlement[]
  savedFilters  SavedFilter[]
  categories    Category[]
  notifications Notification[]
}

// A person in a group. May exist without an account (userId = null) until someone
// joins with the invite code and claims it.
model Participant {
  id                 String   @id @default(cuid())
  groupId            String
  name               String
  userId             String? // Supabase auth user id
  // Alias/CVU to get paid in this group: overrides the account's (UserProfile) or, without account, is the only one
  paymentAlias       String?
  // Their notifications of this group don't reach their devices ("Silenciar"); the app still shows them
  notificationsMuted Boolean  @default(false)
  createdAt          DateTime @default(now())

  group             Group          @relation(fields: [groupId], references: [id])
  expensesPaid      Expense[]
  splits            ExpenseSplit[]
  settlementsPaid   Settlement[]   @relation("SettlementFrom")
  settlementsGotten Settlement[]   @relation("SettlementTo")
  notificationsMade Notification[]

  @@unique([groupId, userId])
  @@index([groupId])
}
