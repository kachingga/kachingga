// An expense category of a group. Every group starts with the 8 built-in ones (`defaultKey` set,
// see `defaultCategories` in src/schemas.ts); members can add more, rename, recolor or archive them.
// Never deleted: archived ones keep their expenses but can't be picked for new ones.
// Names are unique among the group's active categories, ignoring case: checked in the API and enforced
// by the partial index "Category_active_name_key" (migration nombre_de_categoria_unico; Prisma can't express it).
model Category {
  id         String    @id @default(cuid())
  groupId    String
  name       String
  icon       String // one of `categoryIcons` (lucide icon name)
  color      String // one of `categoryColors` (theme color name, never hex)
  defaultKey String? // FOOD, GROCERIES… for the built-in ones; null = created by a member
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // null = active

  group    Group     @relation(fields: [groupId], references: [id])
  expenses Expense[]

  @@index([groupId])
}
